{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-uOGujj769DA4Q92wsfeGI4EFlZov1xIMYr0FqGF9f9Q='; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; frame-src 'none'; object-src 'none'; media-src 'none'; worker-src 'none'; base-uri 'none'; form-action https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://www.narratrace.io/api/csp-report;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/services-5",
      "destination": "/services.html",
      "permanent": true
    },
    {
      "source": "/about-1",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/about-1-1",
      "destination": "/about.html",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/.*(?:\\.|%(?:25)*(?:2[eE]))(?:(?:[mM]|%(?:25)*(?:6[dD]|4[dD]))(?:[dD]|%(?:25)*(?:64|44))(?:(?:[xX]|%(?:25)*(?:78|58)))?|(?:[mM]|%(?:25)*(?:6[dD]|4[dD]))(?:[aA]|%(?:25)*(?:61|41))(?:[rR]|%(?:25)*(?:72|52))(?:[kK]|%(?:25)*(?:6[bB]|4[bB]))(?:[dD]|%(?:25)*(?:64|44))(?:[oO]|%(?:25)*(?:6[fF]|4[fF]))(?:[wW]|%(?:25)*(?:77|57))(?:[nN]|%(?:25)*(?:6[eE]|4[eE])))(?:[^a-zA-Z0-9].*)?",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff"
      }
    }
  ],
  "outputDirectory": "dist",
  "buildCommand": "node scripts/vercel-build.mjs"
}
